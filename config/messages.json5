{
  discordUserChats: "[{role}] {author} » {content}",
  //    Variables: {game}, {gameVersion}, {onlinePlayers}, {playerLimit}
  //    {mspt}, {tps}, {targetTps}, {uptime}
  //    If the message is player-related:
  //        {playerName}, {playerDisplayName}, {playerQualifiedName}, {playerUuid}, {playerAvatar}
  playerChats: {
    // Special Variables: {messageContent}, {channelName}
    asWebhook: true,
    standard: {
      content: "{messageContent}"
    }
  },
  playerJoins: {
    standard: {
      content: "**{playerQualifiedName} joined the game**"
    }
  },
  playerLeaves: {
    standard: {
      content: "**{playerQualifiedName} left the game**"
    }
  },
  playerDies: {
    // Special Variables: {deathMessage}
    standard: {
      embed: {
        color: 0xFA003F,
        authorName: "{deathMessage}",
        authorIcon: "{playerAvatar}",
      }
    }
  },
  mcPlayerAdvances: {
    // Special Variables: {advancementType}, {advancementName}, {advancementDescription}
    // {actionType}: "completed" when it's a challenge or goal, "made" when it's an advancement.
    asWebhook: false,
    standard: {
      embed: {
        color: 0x008000,
        authorName: "{playerQualifiedName} has {actionType} the {advancementType}",
        authorIcon: "{playerAvatar}",
        description: "**{advancementName}**\n`{advancementDescription}`"
      }
    }
  },
  serverStarts: {
    standard: {
      content: "**Server started**"
    }
  },
  serverStops: {
    standard: {
      content: "**Server closed**"
    }
  }
}