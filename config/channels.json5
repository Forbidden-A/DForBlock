{
  default: {
    // The discord channel Id
    channelId: 123,
    // Whether this channel supports webhooks
    //    If this is enabled, 'webhookToken' and 'webhookId' become required
    allowsWebhooks: true,
    // Webhook credentials
    webhookToken: "abc",
    webhookId: 123,
    // The topic template
    //    If this is empty the feature is disabled
    //    Variables: {game}, {gameVersion}, {onlinePlayers}, {playerLimit}
    //    {mspt}, {tps}, {targetTps}, {uptime}
    topicTemplate: "{game} {gameVersion} | {onlinePlayers}/{playerLimit} | {mspt}mspt @ {tps}/{targetTps}tps. Up for {uptime}."
  }
}